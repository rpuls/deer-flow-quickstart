# DeerFlow Gateway image for one-click PaaS deployments (Railway & friends).
#
# Differences from backend/Dockerfile, all of them deliberate:
#   * Bakes config.example.yaml and skills/ into the image. There are no bind
#     mounts on Railway, and app.quickstart.config_builder renders config.yaml
#     from the example at container start.
#   * Installs the postgres + redis extras unconditionally - a managed Postgres
#     add-on is the whole point of this deployment shape.
#   * Skips the Lark/Feishu CLI. It adds minutes to every build and a managed
#     deployment cannot use the CLI login flow anyway; the Python IM channel
#     SDKs are still installed as normal dependencies.
#   * Starts through docker-entrypoint.sh, which writes config.yaml before
#     uvicorn binds a port.
#
# Build context: the repository root.

ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.1
FROM ${UV_IMAGE} AS uv-source

# -- Builder ------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS builder

ARG NODE_MAJOR=22
# Extras installed into the virtualenv. postgres and redis are the managed
# add-ons this image is built for; override to add e.g. `ollama` or `browser`.
ARG UV_EXTRAS="postgres,redis"

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl \
      git \
      build-essential \
      gnupg \
      ca-certificates \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv-source /uv /uvx /usr/local/bin/

WORKDIR /app
COPY backend ./backend

# Deliberately no `--mount=type=cache` here. Railway's builder only accepts a
# cache mount whose id is `s/<service id>-<target>`, and its docs are explicit
# that env vars cannot be used in a cache mount id -- so a one-click template,
# which has no way to know the service id it will be deployed as, cannot name
# one. Layer caching still covers the common rebuild; this costs a wheel
# re-download only when backend/ itself changes.
RUN sh -c 'cd backend && \
    set -f; \
    extras_flags=""; \
    for extra in $(printf "%s" "$UV_EXTRAS" | tr "," " "); do \
        case "$extra" in \
            [!A-Za-z]* | *[!A-Za-z0-9_-]*) \
                echo "UV_EXTRAS entry $extra is invalid (must match [A-Za-z][A-Za-z0-9_-]*)" >&2; \
                exit 1; \
                ;; \
        esac; \
        extras_flags="$extras_flags --extra $extra"; \
    done; \
    uv sync --locked $extras_flags'

# -- Runtime ------------------------------------------------------------------
FROM python:3.12-slim-bookworm

# Minimal containers often ship no locale, and DeerFlow streams Chinese text and
# emoji through stdout.
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONIOENCODING=utf-8 \
    PYTHONUNBUFFERED=1

# Node provides npx, which is how MCP stdio servers are launched.
COPY --from=builder /usr/bin/node /usr/bin/node
COPY --from=builder /usr/lib/node_modules /usr/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/bin/npx

COPY --from=uv-source /uv /uvx /usr/local/bin/

WORKDIR /app

COPY --from=builder /app/backend ./backend
# Rendered into config.yaml at start-up. Without it the container cannot build
# a config, so it is a hard build input rather than a mount.
COPY config.example.yaml ./config.example.yaml
COPY extensions_config.example.json ./extensions_config.example.json
COPY skills ./skills
COPY contracts ./contracts
COPY deploy/railway/docker-entrypoint.sh /usr/local/bin/deerflow-entrypoint
RUN chmod +x /usr/local/bin/deerflow-entrypoint

ENV DEER_FLOW_PROJECT_ROOT=/app \
    DEER_FLOW_HOME=/app/.deer-flow \
    DEER_FLOW_CONFIG_PATH=/app/config.yaml \
    DEER_FLOW_EXTENSIONS_CONFIG_PATH=/app/extensions_config.json \
    DEER_FLOW_SKILLS_PATH=/app/skills \
    DEER_FLOW_QUICKSTART_MANAGED_CONFIG=1 \
    PORT=8001

EXPOSE 8001

ENTRYPOINT ["/usr/local/bin/deerflow-entrypoint"]
